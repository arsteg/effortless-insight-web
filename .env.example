# EffortlessInsight Web - Environment Variables
# Copy this file to .env.local and fill in your values

# API Configuration
NEXT_PUBLIC_API_URL=https://api.effortlessinsight.in

# Public site base URL (used for metadata, canonical URLs, robots, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://effortlessinsight.in

# Company / legal entity identity (footer, contact, legal pages).
# Keep consistent with the API "Billing" appsettings section and GST registration.
NEXT_PUBLIC_COMPANY_BRAND=EffortlessInsight
NEXT_PUBLIC_COMPANY_LEGAL_NAME=ARSTEG SOLUTIONS PRIVATE LIMITED
NEXT_PUBLIC_COMPANY_CIN=U72300HR2015PTC057471
NEXT_PUBLIC_COMPANY_GSTIN=06AANCA9681K1ZZ
NEXT_PUBLIC_COMPANY_ADDRESS=Aravali Heights, Sector 24, Dharuhera, Rewari, Haryana – 123106, India
NEXT_PUBLIC_COMPANY_JURISDICTION=Rewari, Haryana
NEXT_PUBLIC_COMPANY_EMAIL=info@effortlessinsight.in
# Pre-sales inbox. No support@ — customer support is in-app (dashboard), not email.
NEXT_PUBLIC_COMPANY_SALES_EMAIL=sales@effortlessinsight.in
NEXT_PUBLIC_COMPANY_PHONE=+91 93113 91932
NEXT_PUBLIC_COMPANY_PHONE_HREF=+919311391932

# Razorpay Configuration (for payment processing)
NEXT_PUBLIC_RAZORPAY_KEY=rzp_test_xxx

# Firebase Configuration for Push Notifications
# Get these values from Firebase Console > Project Settings > General > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abc123def456

# VAPID Key for Web Push
# Get from Firebase Console > Project Settings > Cloud Messaging > Web Push certificates
NEXT_PUBLIC_FIREBASE_VAPID_KEY=BNx...

# Optional: App Version (used for push token registration)
NEXT_PUBLIC_APP_VERSION=1.0.0
